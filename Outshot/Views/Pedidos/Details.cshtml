@model Outshot.Models.Pedido

@{
    ViewData["Title"] = "Detalles del pedido";
    bool esAdministrador = User.IsInRole("Administrador");
    bool pedidoPendiente = Model.Estado == "Pendiente";
    bool tieneProductos = Model.DetallePedidos != null &&
                          Model.DetallePedidos.Any();
}

<div class="page-header">
    <h1 class="page-title">Detalles del pedido</h1>
    <p class="page-subtitle">
        Consultá la información del pedido registrado en OUTSHOT.
    </p>
</div>

<div class="module-layout">
    <section class="outshot-panel">

        <div class="panel-header">
            <h2>Información del pedido</h2>
            <p>Datos generales del pedido seleccionado.</p>
        </div>

        <div class="panel-body">

            @if (TempData["MensajePedido"] != null)
            {
                <div class="alert alert-success">
                    @TempData["MensajePedido"]
                </div>
            }

            @if (TempData["ErrorPedido"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorPedido"]
                </div>
            }

            <dl class="row">

                <dt class="col-sm-4">Número de pedido</dt>
                <dd class="col-sm-8">@Model.PedidoId</dd>

                <dt class="col-sm-4">Cliente</dt>
                <dd class="col-sm-8">
                    @(Model.Cliente?.Nombre ?? "No disponible")
                </dd>

                <dt class="col-sm-4">Usuario responsable</dt>
                <dd class="col-sm-8">
                    @(Model.Usuario?.Nombre ?? "No disponible")
                </dd>

                <dt class="col-sm-4">Fecha</dt>
                <dd class="col-sm-8">
                    @Model.Fecha.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8">@Model.Estado</dd>

                <dt class="col-sm-4">Total</dt>
                <dd class="col-sm-8">
                    <strong>₡@Model.Total.ToString("N2")</strong>
                </dd>

            </dl>

            <hr />

            <h3>Productos del pedido</h3>

            @if (pedidoPendiente)
            {
                <div class="mb-3">
                    <a asp-action="AgregarProducto"
                       asp-route-id="@Model.PedidoId"
                       class="outshot-btn">
                        Agregar producto
                    </a>
                </div>
            }

            <div class="table-responsive">

                <table class="table">

                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Precio unitario</th>
                            <th>Subtotal</th>

                            @if (esAdministrador)
                            {
                                <th>Acciones</th>
                            }
                        </tr>
                    </thead>

                    <tbody>

                        @if (tieneProductos)
                        {
                            @foreach (var detalle in Model.DetallePedidos ?? Enumerable.Empty<Outshot.Models.DetallePedido>())
                            {
                                <tr>

                                    <td>
                                        @(detalle.Producto?.Nombre ?? "No disponible")
                                    </td>

                                    <td>@detalle.Cantidad</td>

                                    <td>
                                        ₡@detalle.PrecioUnitario.ToString("N2")
                                    </td>

                                    <td>
                                        ₡@detalle.Subtotal.ToString("N2")
                                    </td>

                                    @if (esAdministrador)
                                    {
                                        <td>
                                            <div class="table-actions">

                                                @if (pedidoPendiente)
                                                {
                                                    <a asp-action="EditarDetalle"
                                                       asp-route-id="@detalle.DetallePedidoId">
                                                        Editar
                                                    </a>

                                                    <form asp-action="EliminarDetalle"
                                                          asp-route-id="@detalle.DetallePedidoId"
                                                          method="post"
                                                          onsubmit="return confirm('¿Deseás eliminar este producto del pedido?');">

                                                        <button type="submit"
                                                                class="btn btn-link text-danger p-0">
                                                            Eliminar
                                                        </button>

                                                    </form>
                                                }

                                            </div>
                                        </td>
                                    }

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(esAdministrador ? 5 : 4)"
                                    class="text-center py-4">
                                    Este pedido todavía no tiene productos.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="mt-3">

                @if (pedidoPendiente && tieneProductos)
                {
                    <form asp-action="Confirmar"
                          asp-route-id="@Model.PedidoId"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('¿Deseás confirmar este pedido? Después no podrás modificar sus productos.');">

                        <button type="submit" class="outshot-btn">
                            Confirmar pedido
                        </button>

                    </form>
                }

                @if (esAdministrador)
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.PedidoId"
                       class="outshot-btn">
                        Editar pedido
                    </a>
                }

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Volver al listado
                </a>

            </div>

        </div>
    </section>
</div>
