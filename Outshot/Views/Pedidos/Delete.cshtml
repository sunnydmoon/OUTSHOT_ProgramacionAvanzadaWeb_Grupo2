@model Outshot.Models.Pedido

@{
    ViewData["Title"] = "Eliminar pedido";
}

<div class="page-header">
    <h1 class="page-title">Eliminar pedido</h1>
    <p class="page-subtitle">
        Revisá la información antes de eliminar este pedido.
    </p>
</div>

<div class="module-layout">

    <section class="outshot-panel">

        <div class="panel-header">
            <h2>Confirmar eliminación</h2>
            <p>¿Estás seguro de que deseas eliminar este pedido?</p>
        </div>

        <div class="panel-body">

            <dl class="row">

                <dt class="col-sm-4">Número de pedido</dt>
                <dd class="col-sm-8">@Model.PedidoId</dd>

                <dt class="col-sm-4">Cliente</dt>
                <dd class="col-sm-8">@Model.Cliente.Nombre</dd>

                <dt class="col-sm-4">Usuario responsable</dt>
                <dd class="col-sm-8">@Model.Usuario.Nombre</dd>

                <dt class="col-sm-4">Fecha</dt>
                <dd class="col-sm-8">
                    @Model.Fecha.ToString("dd/MM/yyyy")
                </dd>

                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8">@Model.Estado</dd>

                <dt class="col-sm-4">Total</dt>
                <dd class="col-sm-8">
                    ₡@Model.Total.ToString("N2")
                </dd>

            </dl>

            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="PedidoId" />

                <button type="submit" class="btn btn-danger">
                    Confirmar eliminación
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </section>

</div>
