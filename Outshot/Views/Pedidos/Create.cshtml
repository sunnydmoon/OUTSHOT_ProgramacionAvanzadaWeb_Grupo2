@model Outshot.Models.Pedido

@{
    ViewData["Title"] = "Nuevo pedido";
}

<div class="page-header">
    <h1 class="page-title">Nuevo pedido</h1>
    <p class="page-subtitle">
        Registrá un nuevo pedido en OUTSHOT.
    </p>
</div>

<div class="module-layout">

    <section class="outshot-panel outshot-panel-form">

        <div class="panel-header">
            <h2>Información del pedido</h2>
            <p>Completá los datos para registrar el pedido.</p>
        </div>

        <div class="panel-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                @if (User.IsInRole("Administrador"))
                {
                    <div class="form-group">
                        <label asp-for="ClienteId" class="control-label">
                            Cliente
                        </label>

                        <select asp-for="ClienteId"
                                class="form-select"
                                asp-items="ViewBag.ClienteId">
                            <option value="">Seleccionar cliente</option>
                        </select>

                        <span asp-validation-for="ClienteId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="form-group">
                        <label asp-for="UsuarioId" class="control-label">
                            Usuario responsable
                        </label>

                        <select asp-for="UsuarioId"
                                class="form-select"
                                asp-items="ViewBag.UsuarioId">
                            <option value="">Seleccionar usuario</option>
                        </select>

                        <span asp-validation-for="UsuarioId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Estado" class="control-label">
                            Estado del pedido
                        </label>

                        <input asp-for="Estado"
                               class="form-control"
                               placeholder="Ej. Pendiente" />

                        <span asp-validation-for="Estado"
                              class="text-danger">
                        </span>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="ClienteId" />
                    <input type="hidden" asp-for="UsuarioId" />
                    <input type="hidden" asp-for="Estado" value="Pendiente" />

                    <div class="alert alert-info">
                        El pedido quedará asociado automáticamente a tu cuenta
                        y tendrá el estado inicial Pendiente.
                    </div>
                }

                <div class="alert alert-secondary mt-3">
                    Después de registrar el pedido, podrás seleccionar
                    los productos y las cantidades que deseas incluir.
                </div>

                <div class="form-group mt-3">

                    <button type="submit" class="outshot-btn">
                        Crear pedido
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Volver al listado
                    </a>

                </div>

            </form>

        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
