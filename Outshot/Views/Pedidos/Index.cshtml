@model IEnumerable<Outshot.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";
    bool esAdministrador = User.IsInRole("Administrador");
}

<div class="page-header">
    <h1 class="page-title">
        @(esAdministrador ? "Gestión de pedidos" : "Mis pedidos")
    </h1>

    <p class="page-subtitle">
        @(esAdministrador
            ? "Administrá los pedidos registrados en OUTSHOT."
            : "Consultá tus pedidos y revisá su estado actual.")
    </p>
</div>

<div class="outshot-panel">

    <div class="panel-header">
        <h2>
            @(esAdministrador ? "Listado de pedidos" : "Historial de pedidos")
        </h2>

        <p>
            @(esAdministrador
                ? "Consultá y administrá los pedidos de los clientes."
                : "Aquí encontrarás los pedidos asociados a tu cuenta.")
        </p>
    </div>

    <div class="panel-body">

        <div class="mb-3">
            <a asp-action="Create" class="outshot-btn">
                Nuevo pedido
            </a>
        </div>

        <div class="table-responsive">

            <table class="table">

                <thead>
                    <tr>
                        <th>Número</th>

                        @if (esAdministrador)
                        {
                            <th>Cliente</th>
                            <th>Usuario</th>
                        }

                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Total</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@item.PedidoId</strong>
                                </td>

                                @if (esAdministrador)
                                {
                                    <td>
                                        @(item.Cliente?.Nombre ?? "No disponible")
                                    </td>

                                    <td>
                                        @(item.Usuario?.Nombre ?? "No disponible")
                                    </td>
                                }

                                <td>
                                    @item.Fecha.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @item.Estado
                                </td>

                                <td>
                                    <strong>
                                        ₡@item.Total.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    <div class="table-actions">

                                        <a asp-action="Details"
                                           asp-route-id="@item.PedidoId">
                                            Ver
                                        </a>

                                        @if (esAdministrador)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.PedidoId">
                                                Editar
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.PedidoId">
                                                Eliminar
                                            </a>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(esAdministrador ? 7 : 5)"
                                class="text-center py-4">

                                @(esAdministrador
                                    ? "No hay pedidos registrados."
                                    : "Todavía no tienes pedidos registrados.")

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
