@model Outshot.Models.Pedido

@{
    ViewData["Title"] = "Editar pedido";
}

<div class="page-header">
    <h1 class="page-title">Editar pedido</h1>
    <p class="page-subtitle">
        Actualizá la información del pedido registrado en OUTSHOT.
    </p>
</div>

<div class="module-layout">

    <section class="outshot-panel outshot-panel-form">

        <div class="panel-header">
            <h2>Información del pedido</h2>
            <p>Modificá los datos del pedido seleccionado.</p>
        </div>

        <div class="panel-body">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="PedidoId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <div class="form-group">
                    <label asp-for="ClienteId" class="control-label">
                        Cliente
                    </label>

                    <select asp-for="ClienteId"
                            class="form-select"
                            asp-items="ViewBag.ClienteId">
                        <option value="">Seleccionar cliente</option>
                    </select>

                    <span asp-validation-for="ClienteId"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="UsuarioId" class="control-label">
                        Usuario responsable
                    </label>

                    <select asp-for="UsuarioId"
                            class="form-select"
                            asp-items="ViewBag.UsuarioId">
                        <option value="">Seleccionar usuario</option>
                    </select>

                    <span asp-validation-for="UsuarioId"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="Estado" class="control-label">
                        Estado del pedido
                    </label>

                    <input asp-for="Estado" class="form-control" />

                    <span asp-validation-for="Estado"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group mt-3">

                    <button type="submit" class="outshot-btn">
                        Guardar cambios
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Volver al listado
                    </a>

                </div>

            </form>

        </div>

    </section>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
