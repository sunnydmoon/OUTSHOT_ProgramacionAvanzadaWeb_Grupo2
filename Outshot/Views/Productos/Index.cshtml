@model IEnumerable<Outshot.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<div class="page-header">
    <h1 class="page-title">Productos</h1>
    <p class="page-subtitle">
        Administrá los productos disponibles en OUTSHOT.
    </p>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="module-layout">
    <section class="outshot-panel outshot-panel-form">
        <div class="panel-header">
            <h2>Nuevo producto</h2>
            <p>Agregá un nuevo producto al catálogo.</p>
        </div>

        <div class="panel-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="form-group">
                    <label for="Nombre">Nombre</label>
                    <input id="Nombre"
                           name="Nombre"
                           class="form-control"
                           value="@ViewData["Nombre"]"
                           placeholder="Ej. Camiseta Nike Negra"
                           minlength="3"
                           maxlength="100"
                           required />
                    @Html.ValidationMessage("Nombre", "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="CategoriaId">Categoría</label>
                    <select id="CategoriaId"
                            name="CategoriaId"
                            class="form-select"
                            asp-items="ViewBag.CategoriaId"
                            required>
                        <option value="">Seleccionar categoría</option>
                    </select>
                    @Html.ValidationMessage("CategoriaId", "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="Precio">Precio</label>
                    <div class="input-group">
                        <span class="input-group-text">₡</span>
                        <input id="Precio"
                               name="Precio"
                               type="number"
                               min="0.01"
                               step="0.01"
                               class="form-control"
                               value="@ViewData["Precio"]"
                               placeholder="0.00"
                               required />
                    </div>
                    @Html.ValidationMessage("Precio", "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="Imagen">Imagen del producto (opcional)</label>
                    <input id="Imagen"
                           name="Imagen"
                           type="file"
                           accept=".jpg,.jpeg,.png,.webp"
                           class="form-control" />
                    <div class="form-text">
                        Formatos permitidos: JPG, PNG y WEBP.
                    </div>
                    @Html.ValidationMessage("Imagen", "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="Descripcion">Descripción</label>
                    <textarea id="Descripcion"
                              name="Descripcion"
                              class="form-control"
                              rows="3"
                              maxlength="500"
                              placeholder="Descripción del producto">@ViewData["Descripcion"]</textarea>
                    @Html.ValidationMessage("Descripcion", "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="Activo"
                               name="Activo"
                               value="true"
                               checked="@(ViewData["Activo"] is bool activo ? activo : true)" />
                        <input type="hidden"
                               name="Activo"
                               value="false" />
                        <label class="form-check-label" for="Activo">
                            Producto activo
                        </label>
                    </div>
                </div>

                <button type="submit" class="outshot-btn">
                    Guardar producto
                </button>
            </form>
        </div>
    </section>

    <section class="outshot-panel">
        <div class="panel-header">
            <h2>Listado de productos</h2>
            <p>Consultá y administrá los productos registrados.</p>
        </div>

        <div class="panel-body">
            <div class="mb-3">
                <input type="text"
                       id="buscarProducto"
                       class="form-control"
                       placeholder="Buscar producto..." />
            </div>

            <div class="table-responsive">
                <table class="table" id="tablaProductos">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th>Precio</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(item.ImagenUrl))
                                            {
                                                <img src="@Url.Content("~/images/productos/" + item.ImagenUrl)"
                                                     alt="@item.Nombre"
                                                     width="55"
                                                     height="55"
                                                     style="object-fit: cover; border-radius: 6px;" />
                                            }

                                            <strong>@item.Nombre</strong>
                                        </div>
                                    </td>

                                    <td>
                                        @(item.Categoria?.Nombre ?? "Sin categoría")
                                    </td>

                                    <td>
                                        <strong>
                                            ₡@item.Precio.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>
                                        @if (item.Activo)
                                        {
                                            <span class="status-active">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="status-inactive">Inactivo</span>
                                        }
                                    </td>

                                    <td>
                                        <div class="table-actions">
                                            <a asp-action="Edit"
                                               asp-route-id="@item.ProductoId">
                                                Editar
                                            </a>

                                            <a asp-action="Details"
                                               asp-route-id="@item.ProductoId">
                                                Ver
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.ProductoId">
                                                Eliminar
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4">
                                    No hay productos registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.getElementById("buscarProducto")
            .addEventListener("keyup", function() {
                const texto = this.value.toLowerCase();
                const filas = document.querySelectorAll(
                    "#tablaProductos tbody tr"
                );

                filas.forEach(function(fila) {
                    const contenido = fila.innerText.toLowerCase();
                    fila.style.display = contenido.includes(texto)
                        ? ""
                        : "none";
                });
            });
    </script>
}
