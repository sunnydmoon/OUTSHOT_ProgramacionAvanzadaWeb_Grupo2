@model Outshot.Models.Producto

@{
    ViewData["Title"] = "Eliminar producto";
}

<h1>Eliminar producto</h1>

<h3>¿Está seguro de que desea eliminar este producto?</h3>

<div>
    <h4>Información del producto</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Categoría</dt>
        <dd class="col-sm-10">
            @(Model.Categoria?.Nombre ?? "Sin categoría")
        </dd>

        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>

        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Model.Descripcion</dd>

        <dt class="col-sm-2">Precio</dt>
        <dd class="col-sm-10">₡@Model.Precio.ToString("N2")</dd>

        <dt class="col-sm-2">Imagen</dt>
        <dd class="col-sm-10">@Model.ImagenUrl</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@(Model.Activo ? "Activo" : "Inactivo")</dd>

        <dt class="col-sm-2">Fecha de registro</dt>
        <dd class="col-sm-10">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="ProductoId" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
