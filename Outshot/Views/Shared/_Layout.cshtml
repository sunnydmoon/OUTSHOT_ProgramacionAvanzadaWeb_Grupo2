
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Outshot</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Outshot.styles.css" asp-append-version="true" />
</head>

<body>

    <div class="outshot-layout">

        <aside class="outshot-sidebar">

            <a class="outshot-logo"
               asp-controller="Home"
               asp-action="Index">
                OUTSHOT
            </a>

            <nav>
                <ul class="outshot-menu">

                    <li>
                        <a asp-controller="Home"
                           asp-action="Index">
                            <span class="outshot-menu-icon">⌂</span>
                            <span>Inicio</span>
                        </a>
                    </li>

                    @if (!User.Identity!.IsAuthenticated ||
                         User.IsInRole("Administrador"))
                    {
                        <li>
                            <a asp-controller="Categorias"
                               asp-action="Index">
                                <span class="outshot-menu-icon">◇</span>
                                <span>Categorías</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Inventarios"
                               asp-action="Index">
                                <span class="outshot-menu-icon">▦</span>
                                <span>Inventario</span>
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Reportes"
                               asp-action="Dashboard">
                                <span class="outshot-menu-icon">◔</span>
                                <span>Reportes</span>
                            </a>
                        </li>
                    }

                    <li>
                        <a asp-controller="Productos"
                           asp-action="Index">
                            <span class="outshot-menu-icon">▢</span>
                            <span>Productos</span>
                        </a>
                    </li>


                    @if (User.Identity!.IsAuthenticated)
                    {
                        @if (User.IsInRole("Administrador"))
                        {
                            <li>
                                <a asp-controller="Clientes"
                                   asp-action="Index">
                                    <span class="outshot-menu-icon">♙</span>
                                    <span>Clientes</span>
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Pedidos"
                                   asp-action="Index">
                                    <span class="outshot-menu-icon">▤</span>
                                    <span>Gestión de pedidos</span>
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Cliente"))
                        {
                            <li>
                                <a asp-controller="Pedidos"
                                   asp-action="Index">
                                    <span class="outshot-menu-icon">▤</span>
                                    <span>Mis pedidos</span>
                                </a>
                            </li>
                        }
                    }

                </ul>
            </nav>

        </aside>

        <div class="outshot-content">

            <header class="outshot-topbar">

                <div class="outshot-user">

                    @if (User.Identity!.IsAuthenticated)
                    {
                        <div class="outshot-user-circle">
                            @(User.Identity.Name is string nombre &&
                              nombre.Length > 0
                                ? nombre.Substring(0, 1).ToUpper()
                                : "U")
                        </div>

                        <span>@User.Identity.Name</span>

                        <form asp-controller="Autenticacion"
                              asp-action="Logout"
                              method="post"
                              class="d-inline ms-3">

                            <button type="submit"
                                    class="btn btn-outline-dark btn-sm">
                                Cerrar sesión
                            </button>

                        </form>
                    }
                    else
                    {
                        <a asp-controller="Autenticacion"
                           asp-action="Login"
                           class="btn btn-outline-dark btn-sm me-2">
                            Iniciar sesión
                        </a>

                        <a asp-controller="Autenticacion"
                           asp-action="Registro"
                           class="btn btn-dark btn-sm">
                            Registrarse
                        </a>
                    }

                </div>

            </header>

            <main class="outshot-main">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
