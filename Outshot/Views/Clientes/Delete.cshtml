@model Outshot.Models.Cliente

@{
    ViewData["Title"] = "Eliminar cliente";
}

<div class="page-header">
    <h1 class="page-title">Eliminar cliente</h1>
    <p class="page-subtitle">
        Revisá la información antes de eliminar este cliente.
    </p>
</div>

<div class="module-layout">

    <section class="outshot-panel">

        <div class="panel-header">
            <h2>Confirmar eliminación</h2>
            <p>¿Estás seguro de que deseas eliminar este cliente?</p>
        </div>

        <div class="panel-body">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <dl class="row">

                <dt class="col-sm-4">Nombre completo</dt>
                <dd class="col-sm-8">@Model.Nombre</dd>

                <dt class="col-sm-4">Correo electrónico</dt>
                <dd class="col-sm-8">@Model.Correo</dd>

                <dt class="col-sm-4">Teléfono</dt>
                <dd class="col-sm-8">@Model.Telefono</dd>

                <dt class="col-sm-4">Dirección</dt>
                <dd class="col-sm-8">@Model.Direccion</dd>

                <dt class="col-sm-4">Fecha de registro</dt>
                <dd class="col-sm-8">
                    @Model.FechaRegistro.ToString("dd/MM/yyyy")
                </dd>

            </dl>

            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="ClienteId" />

                <button type="submit" class="btn btn-danger">
                    Confirmar eliminación
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </section>

</div>

